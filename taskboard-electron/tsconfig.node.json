{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "electrobun": ["src/types/electrobun.d.ts"],
      "electrobun/bun": ["src/types/electrobun-bun.d.ts"]
    },
    "types": ["bun", "node"]
  },
  "include": [
    "src/electrobun/**/*.ts",
    "src/types/**/*.d.ts",
    "scripts/**/*.ts",
    "electrobun.config.ts"
  ]
}
